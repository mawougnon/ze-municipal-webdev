generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (session mode) connection, the app uses the pooled one
  directUrl = env("DIRECT_URL")
}

// Platform users (Admin, Secretary, Super Admin)
model User {
  id          String    @id @default(cuid())
  name        String?
  email       String    @unique
  otpHash     String?
  otpExpires  DateTime?
  otpAttempts Int       @default(0)
  role        Role      @default(ADMIN)
  createdAt   DateTime  @default(now())
}

enum Role {
  ADMIN
  SUPERADMIN
}

// News articles published on the public site
model Article {
  id            String         @id @default(cuid())
  title         String
  content       String
  coverImageUrl String?
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        ArticlePhoto[]
}

// Photos attached to a specific article
model ArticlePhoto {
  id        String  @id @default(cuid())
  url       String
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  @@index([articleId])
}

// Job offers and training opportunities
model Opportunity {
  id           String        @id @default(cuid())
  type         String // "JOB" or "TRAINING"
  title        String
  description  String
  deadline     DateTime?
  published    Boolean       @default(false)
  isFree       Boolean       @default(true)
  price        Float? // XOF
  imageUrl     String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

// Applications submitted for an opportunity
model Application {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fullName      String
  email         String?
  phone         String // WhatsApp-compatible number preferred
  message       String?
  files         ApplicationFile[]
  consentAt     DateTime?
  createdAt     DateTime          @default(now())

  @@index([opportunityId])
  @@index([createdAt])
}

// Annual work plan activities (PTA) with real-time tracking

// Single official PTA PDF document for the entire mandate
model Document {
  id          String   @id @default(cuid())
  title       String
  description String
  fileUrl     String
  date        DateTime
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, date])
}

// Security audit log: tracks login attempts and admin actions
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String?
  userEmail String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ApplicationFile {
  path          String       @id
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  ipAddress     String?
  createdAt     DateTime     @default(now())

  @@index([applicationId])
  @@index([createdAt])
}
