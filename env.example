# Database: Supabase PostgreSQL
# Pooled connection (transaction mode, port 6543), used by the app
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (session mode, port 5432), used only by Prisma migrations
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# Auth.js secret key (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-here"

#Admin accounts emails
DEV_EMAIL="dev@dev.com"
SUPERADMIN_EMAIL="superadmin@mairie.gouv"
ADMIN_EMAIL="admin@mairie.gouv"

SUPERADMIN_NAME=""

# Admin accounts passwords (used in seed-users.mjs)
DEV_PASSWORD="your-dev-password"
SUPERADMIN_PASSWORD="your-superadmin-password"

# Public Supabase credentials (safe to expose in frontend; uses row-level security)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

#Resend
RESEND_API_KEY="re_your_api_key_here"


AUTH_SECRET="You already know what's supposed to be here"


ADMIN_SECRET_TOKEN="your-secret-admin-token"